---
import MedicalLayout from '../../layouts/MedicalLayout.astro';

const conditions = [
  { href: '/VanIslandRH/asthma', title: 'Asthma', desc: 'Inflammatory airway disease affecting ~10% of the population. Manageable with proper treatment.' },
  { href: '/VanIslandRH/copd', title: 'COPD', desc: 'Progressive airflow limitation. Smoking is responsible for 85–90% of cases worldwide.' },
  { href: '/VanIslandRH/sleep-disorders', title: 'Sleep Disorders', desc: 'Obstructive and central sleep apnea diagnosis and management.' },
  { href: '/VanIslandRH/pulmonary-fibrosis', title: 'Pulmonary Fibrosis', desc: 'Scarring of lung tissue that can result from a range of underlying causes.' },
  { href: '/VanIslandRH/pleural-effusions', title: 'Pleural Effusions', desc: 'Fluid accumulation around the lungs — diagnosis, drainage, and management.' },
];
---
<MedicalLayout title="Vancouver Island Respirology — Dr. Han Sen Phang">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-eyebrow">Vancouver Island Respirology</p>
        <h1>Dr. Han Sen Phang</h1>
        <p class="hero-role">Respirologist · Royal Jubilee Hospital · Victoria, BC</p>
        <p class="hero-desc">Providing specialist pulmonary care for patients with chronic lung conditions across Southern Vancouver Island. Empowering patients with the knowledge to live fuller, healthier lives.</p>
        <a href="/VanIslandRH/contact" class="btn-primary">Book a Referral</a>
      </div>
      <div class="hero-badge">
        <div class="badge-icon">🫁</div>
        <p class="badge-label">Respiratory Specialist</p>
        <p class="badge-sub">Island Health · Victoria, BC</p>
      </div>
    </div>
  </section>

  <section class="conditions">
    <div class="section-inner">
      <h2>Conditions We Treat</h2>
      <p class="section-sub">Click any condition to learn more about diagnosis, symptoms, and management options.</p>
      <div class="card-grid">
        {conditions.map(c => (
          <a href={c.href} class="card">
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
            <span class="card-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="services-strip">
    <div class="section-inner">
      <div class="services-row">
        <div>
          <h2>Diagnostic Services</h2>
          <p>Comprehensive pulmonary testing to accurately diagnose and monitor your condition.</p>
          <a href="/VanIslandRH/services" class="btn-outline">View All Services →</a>
        </div>
        <ul class="services-list">
          <li>Spirometry &amp; Full Pulmonary Function Tests</li>
          <li>Methacholine Challenge Testing</li>
          <li>Chest X-ray &amp; CT Imaging</li>
          <li>Flexible Bronchoscopy &amp; EBUS</li>
          <li>Inhaler Technique Education</li>
          <li>Airway Clearance Therapy</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="contact-strip">
    <div class="section-inner">
      <h2>Contact &amp; Location</h2>
      <div class="contact-cards">
        <div class="contact-card">
          <h3>Clinic</h3>
          <p>1990 Fort St, Suite 309<br />Victoria, BC V8R 6V4</p>
          <p><a href="tel:2503830250">250-383-0250</a></p>
        </div>
        <div class="contact-card">
          <h3>PFT Lab</h3>
          <p>Royal Jubilee Hospital<br />1952 Bay St, Royal Block, 4th Floor<br />Victoria, BC V8R 1J8</p>
          <p><a href="tel:2505191642">250-519-1642</a></p>
        </div>
      </div>
    </div>
  </section>
</MedicalLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    border-bottom: 1px solid #bae6fd;
    padding: 4rem 1.5rem;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .hero-text { flex: 1; }

  .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0369a1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .hero-text h1 {
    font-size: 3rem;
    font-weight: 800;
    color: #0c1a2e;
    margin-bottom: 0.25rem;
  }

  .hero-role {
    font-size: 1.1rem;
    color: #0369a1;
    font-weight: 500;
    margin-bottom: 1.25rem;
  }

  .hero-desc {
    font-size: 1rem;
    color: #374151;
    line-height: 1.7;
    max-width: 540px;
    margin-bottom: 2rem;
  }

  .btn-primary {
    display: inline-block;
    background-color: #0369a1;
    color: #ffffff;
    padding: 0.75rem 2rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 1rem;
    transition: background-color 0.2s;
    text-decoration: none;
  }

  .btn-primary:hover {
    background-color: #0284c7;
    color: #ffffff;
  }

  .hero-badge {
    flex-shrink: 0;
    width: 200px;
    background: #ffffff;
    border: 1px solid #bae6fd;
    border-radius: 16px;
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: 0 4px 12px rgba(3,105,161,0.08);
  }

  .badge-icon { font-size: 3rem; margin-bottom: 0.75rem; }

  .badge-label {
    font-weight: 700;
    font-size: 0.95rem;
    color: #0369a1;
    margin: 0 0 0.25rem;
  }

  .badge-sub {
    font-size: 0.8rem;
    color: #6b7280;
    margin: 0;
  }

  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .section-inner h2 {
    font-size: 1.875rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-sub {
    color: #6b7280;
    margin-bottom: 2rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: block;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.5rem;
    text-decoration: none;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.15s;
  }

  .card:hover {
    border-color: #7dd3fc;
    box-shadow: 0 4px 12px rgba(3,105,161,0.1);
    transform: translateY(-2px);
  }

  .card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0369a1;
    margin-bottom: 0.5rem;
  }

  .card p {
    font-size: 0.9rem;
    color: #4b5563;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .card-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0369a1;
  }

  .services-strip {
    background: #f8fafc;
    border-top: 1px solid #e5e7eb;
    border-bottom: 1px solid #e5e7eb;
  }

  .services-row {
    display: flex;
    gap: 4rem;
    align-items: flex-start;
  }

  .services-row > div { flex: 1; }

  .services-row h2 { margin-bottom: 0.5rem; }

  .btn-outline {
    display: inline-block;
    border: 2px solid #0369a1;
    color: #0369a1;
    padding: 0.6rem 1.5rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: background-color 0.2s, color 0.2s;
    text-decoration: none;
    margin-top: 1rem;
  }

  .btn-outline:hover {
    background-color: #0369a1;
    color: #ffffff;
  }

  .services-list {
    flex: 1;
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }

  .services-list li {
    padding: 0.6rem 0.75rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    font-size: 0.9rem;
    color: #374151;
  }

  .contact-cards {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .contact-card {
    flex: 1;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 10px;
    padding: 1.5rem;
  }

  .contact-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #0369a1;
    margin-bottom: 0.75rem;
  }

  .contact-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .hero-inner { flex-direction: column; }
    .hero-badge { width: 100%; }
    .hero-text h1 { font-size: 2rem; }
    .services-row { flex-direction: column; gap: 2rem; }
    .services-list { grid-template-columns: 1fr; }
    .contact-cards { flex-direction: column; }
  }
</style>
