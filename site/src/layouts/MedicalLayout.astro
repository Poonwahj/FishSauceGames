---
import MedicalNav from '../components/MedicalNav.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <MedicalNav />
  <main>
    <slot />
  </main>
  <footer class="footer">
    <div class="footer-inner">
      <p>© {new Date().getFullYear()} Dr. Han Sen Phang · Vancouver Island Respirology</p>
      <p class="disclaimer">This website is intended to supplement, not replace, consultation with your healthcare provider.</p>
    </div>
  </footer>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background-color: #ffffff;
    color: #1f2937;
    line-height: 1.6;
  }

  h1, h2, h3, h4, h5, h6 {
    color: #111827;
    margin-top: 0;
    line-height: 1.2;
  }

  a {
    color: #0369a1;
    text-decoration: none;
  }

  a:hover {
    color: #0284c7;
  }

  p {
    margin-top: 0;
    margin-bottom: 1rem;
    color: #374151;
  }

  ul {
    color: #374151;
  }
</style>

<style>
  .footer {
    background-color: #f8fafc;
    border-top: 1px solid #e5e7eb;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .footer-inner p {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: #6b7280;
  }

  .disclaimer {
    font-size: 0.8rem !important;
    color: #9ca3af !important;
    font-style: italic;
  }
</style>
